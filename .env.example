# Environment Variables Template

# Primary LLM API Keys (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Fallback Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Forms Link for Human Escalations
ESCALATION_FORM_URL=https://forms.gle/dummy_form_link
